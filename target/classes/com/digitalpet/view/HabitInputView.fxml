<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane styleClass="habit-input-view" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.digitalpet.view.HabitInputViewController">
   <center>
      <ScrollPane fitToWidth="true" styleClass="habit-scroll-pane">
         <VBox alignment="CENTER" spacing="20.0">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            
            <Label text="Daily Habits" styleClass="habit-input-title">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            
            <!-- Study Hours -->
            <VBox spacing="5.0">
               <Label text="Study Hours" />
               <Slider fx:id="studyHoursSlider" min="0" max="16" value="0" />
               <Label fx:id="studyHoursValue" text="0 hours" />
               <Label fx:id="studyHoursError" text="" visible="false" />
            </VBox>
            
            <!-- Water Intake -->
            <VBox spacing="5.0">
               <Label text="Water Intake" />
               <Slider fx:id="waterIntakeSlider" min="0" max="5" value="0" />
               <Label fx:id="waterIntakeValue" text="0.0 L" />
               <Label fx:id="waterIntakeError" text="" visible="false" />
            </VBox>
            
            <!-- Steps Taken -->
            <VBox spacing="5.0">
               <Label text="Steps Taken" />
               <Slider fx:id="stepsTakenSlider" min="0" max="50000" value="0" />
               <Label fx:id="stepsTakenValue" text="0 steps" />
               <Label fx:id="stepsTakenError" text="" visible="false" />
            </VBox>
            
            <!-- Sleep Hours -->
            <VBox spacing="5.0">
               <Label text="Sleep Hours" />
               <Slider fx:id="sleepHoursSlider" min="0" max="24" value="0" />
               <Label fx:id="sleepHoursValue" text="0.0 hours" />
               <Label fx:id="sleepHoursError" text="" visible="false" />
            </VBox>
            
            <!-- Money Spent -->
            <VBox spacing="5.0">
               <Label text="Money Spent" />
               <Slider fx:id="moneySpentSlider" min="0" max="1000" value="0" />
               <Label fx:id="moneySpentValue" text="\$0.00" />
               <Label fx:id="moneySpentError" text="" visible="false" />
            </VBox>
            
            <!-- Goals Completed -->
            <VBox spacing="5.0">
               <Label text="Goals Completed" />
               <Slider fx:id="goalsCompletedSlider" min="0" max="10" value="0" />
               <Label fx:id="goalsCompletedValue" text="0 goals" />
               <Label fx:id="goalsCompletedError" text="" visible="false" />
            </VBox>
            
            <Button fx:id="submitButton" text="Submit Habits" onAction="#onSubmitHabits">
               <font>
                  <Font size="16.0" />
               </font>
            </Button>
            
            <Label fx:id="confirmationMessage" text="" visible="false" />
            <Label fx:id="xpGainMessage" text="" visible="false" />
         </VBox>
      </ScrollPane>
   </center>
   
   <bottom>
      <HBox alignment="CENTER" spacing="0.0" styleClass="bottom-navigation">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         
         <Button fx:id="petTabButton" text="Pet" onAction="#onPetTabClicked">
            <font>
               <Font size="14.0" />
            </font>
         </Button>
         
         <Button fx:id="habitsTabButton" text="Habits" onAction="#onHabitsTabClicked">
            <font>
               <Font size="14.0" />
            </font>
         </Button>
         
         <Button fx:id="statsTabButton" text="Stats" onAction="#onStatsTabClicked">
            <font>
               <Font size="14.0" />
            </font>
         </Button>
         
         <Button fx:id="achievementsTabButton" text="Awards" onAction="#onAchievementsTabClicked">
            <font>
               <Font size="14.0" />
            </font>
         </Button>
      </HBox>
   </bottom>
</BorderPane>