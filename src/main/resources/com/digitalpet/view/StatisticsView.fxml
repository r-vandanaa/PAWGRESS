<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.digitalpet.view.StatisticsViewController">
   <children>
      <!-- Header Section -->
      <VBox styleClass="header-section">
         <children>
            <Label styleClass="page-title" text="Statistics &amp; Progress" />
            <Label styleClass="page-subtitle" text="Track your habit journey and pet's growth" />
         </children>
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
      </VBox>
      
      <!-- Time Range Selection -->
      <HBox alignment="CENTER" spacing="8.0" styleClass="time-range-selector">
         <children>
            <Label text="Time Range:" />
            <fx:define>
               <ToggleGroup fx:id="timeRangeGroup" />
            </fx:define>
            <ToggleButton fx:id="sevenDayButton" selected="true" text="7 Days" toggleGroup="$timeRangeGroup" />
            <ToggleButton fx:id="thirtyDayButton" text="30 Days" toggleGroup="$timeRangeGroup" />
            <ToggleButton fx:id="ninetyDayButton" text="90 Days" toggleGroup="$timeRangeGroup" />
         </children>
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="8.0" />
         </padding>
      </HBox>
      
      <!-- Scrollable Content -->
      <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="24.0">
               <children>
                  <!-- XP Progress Chart Section -->
                  <VBox styleClass="chart-section">
                     <children>
                        <Label styleClass="section-title" text="Experience Points Progress" />
                        <LineChart fx:id="xpProgressChart" animated="false" createSymbols="false" legendVisible="false" prefHeight="200.0">
                           <xAxis>
                              <CategoryAxis fx:id="xpChartXAxis" side="BOTTOM" />
                           </xAxis>
                           <yAxis>
                              <NumberAxis fx:id="xpChartYAxis" side="LEFT" />
                           </yAxis>
                        </LineChart>
                        <Label fx:id="xpSummaryLabel" styleClass="chart-summary" text="Total XP: 0" />
                     </children>
                  </VBox>
                  
                  <!-- Habit Performance Chart Section -->
                  <VBox styleClass="chart-section">
                     <children>
                        <Label styleClass="section-title" text="Habit Performance" />
                        <BarChart fx:id="habitPerformanceChart" animated="false" categoryGap="8.0" prefHeight="250.0">
                           <xAxis>
                              <CategoryAxis fx:id="habitChartXAxis" side="BOTTOM" />
                           </xAxis>
                           <yAxis>
                              <NumberAxis fx:id="habitChartYAxis" side="LEFT" upperBound="100.0" />
                           </yAxis>
                        </BarChart>
                        <HBox alignment="CENTER" spacing="16.0" styleClass="legend-container">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="4.0">
                                 <children>
                                    <Label styleClass="legend-excellent" text="■" />
                                    <Label text="Excellent (80-100%)" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="4.0">
                                 <children>
                                    <Label styleClass="legend-good" text="■" />
                                    <Label text="Good (60-79%)" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="4.0">
                                 <children>
                                    <Label styleClass="legend-needs-improvement" text="■" />
                                    <Label text="Needs Improvement (&lt;60%)" />
                                 </children>
                              </HBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  
                  <!-- Mood History Timeline Section -->
                  <VBox styleClass="chart-section">
                     <children>
                        <Label styleClass="section-title" text="Mood History" />
                        <VBox fx:id="moodTimelineContainer" spacing="8.0" styleClass="mood-timeline">
                           <!-- Mood timeline items will be added dynamically -->
                        </VBox>
                        <Label fx:id="moodSummaryLabel" styleClass="chart-summary" text="Current mood streak: 0 days" />
                     </children>
                  </VBox>
                  
               </children>
               <padding>
                  <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
      
      <!-- Bottom Navigation -->
      <HBox alignment="CENTER" spacing="0.0" styleClass="bottom-navigation">
         <children>
            <Button fx:id="petTabButton" mnemonicParsing="false" onAction="#onPetTabClicked" styleClass="nav-button" text="Pet" HBox.hgrow="ALWAYS" />
            <Button fx:id="habitsTabButton" mnemonicParsing="false" onAction="#onHabitsTabClicked" styleClass="nav-button" text="Habits" HBox.hgrow="ALWAYS" />
            <Button fx:id="statsTabButton" mnemonicParsing="false" onAction="#onStatsTabClicked" styleClass="nav-button-active" text="Stats" HBox.hgrow="ALWAYS" />
            <Button fx:id="achievementsTabButton" mnemonicParsing="false" onAction="#onAchievementsTabClicked" styleClass="nav-button" text="Achievements" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
</VBox>