<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.digitalpet.view.HabitInputViewController">
   <center>
      <ScrollPane fitToWidth="true" styleClass="habit-scroll-pane">
         <VBox alignment="TOP_CENTER" spacing="20.0" styleClass="habit-input-content">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            
            <!-- Header -->
            <VBox alignment="CENTER" spacing="10.0">
               <Label styleClass="habit-input-title" text="Daily Habits">
                  <font>
                     <Font name="System Bold" size="24.0" />
                  </font>
               </Label>
               <Label styleClass="habit-input-subtitle" text="Track your daily activities to help your pet grow!">
                  <font>
                     <Font size="14.0" />
                  </font>
               </Label>
            </VBox>
            
            <!-- Habit Input Form -->
            <VBox spacing="25.0" styleClass="habit-form">
               
               <!-- Study Hours -->
               <VBox spacing="8.0" styleClass="habit-category">
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <Label styleClass="habit-icon" text="📚">
                        <font>
                           <Font size="20.0" />
                        </font>
                     </Label>
                     <Label styleClass="habit-label" text="Study Hours">
                        <font>
                           <Font name="System Bold" size="16.0" />
                        </font>
                     </Label>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="15.0">
                     <Slider fx:id="studyHoursSlider" blockIncrement="1.0" majorTickUnit="4.0" max="16.0" min="0.0" minorTickCount="3" showTickLabels="true" showTickMarks="true" styleClass="habit-slider" value="0.0" HBox.hgrow="ALWAYS" />
                     <Label fx:id="studyHoursValue" styleClass="habit-value" text="0 hours">
                        <font>
                           <Font size="14.0" />
                        </font>
                     </Label>
                  </HBox>
                  <Label fx:id="studyHoursError" styleClass="error-message" text="" visible="false">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
               </VBox>
               
               <!-- Water Intake -->
               <VBox spacing="8.0" styleClass="habit-category">
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <Label styleClass="habit-icon" text="💧">
                        <font>
                           <Font size="20.0" />
                        </font>
                     </Label>
                     <Label styleClass="habit-label" text="Water Intake">
                        <font>
                           <Font name="System Bold" size="16.0" />
                        </font>
                     </Label>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="15.0">
                     <Slider fx:id="waterIntakeSlider" blockIncrement="0.1" majorTickUnit="1.0" max="5.0" min="0.0" minorTickCount="9" showTickLabels="true" showTickMarks="true" styleClass="habit-slider" value="0.0" HBox.hgrow="ALWAYS" />
                     <Label fx:id="waterIntakeValue" styleClass="habit-value" text="0.0 L">
                        <font>
                           <Font size="14.0" />
                        </font>
                     </Label>
                  </HBox>
                  <Label fx:id="waterIntakeError" styleClass="error-message" text="" visible="false">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
               </VBox>
               
               <!-- Steps Taken -->
               <VBox spacing="8.0" styleClass="habit-category">
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <Label styleClass="habit-icon" text="👟">
                        <font>
                           <Font size="20.0" />
                        </font>
                     </Label>
                     <Label styleClass="habit-label" text="Steps Taken">
                        <font>
                           <Font name="System Bold" size="16.0" />
                        </font>
                     </Label>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="15.0">
                     <Slider fx:id="stepsTakenSlider" blockIncrement="1000.0" majorTickUnit="10000.0" max="50000.0" min="0.0" minorTickCount="9" showTickLabels="true" showTickMarks="true" styleClass="habit-slider" value="0.0" HBox.hgrow="ALWAYS" />
                     <Label fx:id="stepsTakenValue" styleClass="habit-value" text="0 steps">
                        <font>
                           <Font size="14.0" />
                        </font>
                     </Label>
                  </HBox>
                  <Label fx:id="stepsTakenError" styleClass="error-message" text="" visible="false">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
               </VBox>
               
               <!-- Sleep Hours -->
               <VBox spacing="8.0" styleClass="habit-category">
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <Label styleClass="habit-icon" text="😴">
                        <font>
                           <Font size="20.0" />
                        </font>
                     </Label>
                     <Label styleClass="habit-label" text="Sleep Hours">
                        <font>
                           <Font name="System Bold" size="16.0" />
                        </font>
                     </Label>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="15.0">
                     <Slider fx:id="sleepHoursSlider" blockIncrement="0.5" majorTickUnit="6.0" max="24.0" min="0.0" minorTickCount="5" showTickLabels="true" showTickMarks="true" styleClass="habit-slider" value="0.0" HBox.hgrow="ALWAYS" />
                     <Label fx:id="sleepHoursValue" styleClass="habit-value" text="0.0 hours">
                        <font>
                           <Font size="14.0" />
                        </font>
                     </Label>
                  </HBox>
                  <Label fx:id="sleepHoursError" styleClass="error-message" text="" visible="false">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
               </VBox>
               
               <!-- Money Spent -->
               <VBox spacing="8.0" styleClass="habit-category">
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <Label styleClass="habit-icon" text="💰">
                        <font>
                           <Font size="20.0" />
                        </font>
                     </Label>
                     <Label styleClass="habit-label" text="Money Spent">
                        <font>
                           <Font name="System Bold" size="16.0" />
                        </font>
                     </Label>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="15.0">
                     <Slider fx:id="moneySpentSlider" blockIncrement="10.0" majorTickUnit="200.0" max="1000.0" min="0.0" minorTickCount="9" showTickLabels="true" showTickMarks="true" styleClass="habit-slider" value="0.0" HBox.hgrow="ALWAYS" />
                     <Label fx:id="moneySpentValue" styleClass="habit-value" text="$0.00">
                        <font>
                           <Font size="14.0" />
                        </font>
                     </Label>
                  </HBox>
                  <Label fx:id="moneySpentError" styleClass="error-message" text="" visible="false">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
               </VBox>
               
               <!-- Goals Completed -->
               <VBox spacing="8.0" styleClass="habit-category">
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <Label styleClass="habit-icon" text="🎯">
                        <font>
                           <Font size="20.0" />
                        </font>
                     </Label>
                     <Label styleClass="habit-label" text="Goals Completed">
                        <font>
                           <Font name="System Bold" size="16.0" />
                        </font>
                     </Label>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="15.0">
                     <Slider fx:id="goalsCompletedSlider" blockIncrement="1.0" majorTickUnit="2.0" max="10.0" min="0.0" minorTickCount="1" showTickLabels="true" showTickMarks="true" styleClass="habit-slider" value="0.0" HBox.hgrow="ALWAYS" />
                     <Label fx:id="goalsCompletedValue" styleClass="habit-value" text="0 goals">
                        <font>
                           <Font size="14.0" />
                        </font>
                     </Label>
                  </HBox>
                  <Label fx:id="goalsCompletedError" styleClass="error-message" text="" visible="false">
                     <font>
                        <Font size="12.0" />
                     </Label>
               </VBox>
            </VBox>
            
            <!-- Submit Button and Feedback -->
            <VBox alignment="CENTER" spacing="15.0" styleClass="submit-section">
               <Button fx:id="submitButton" mnemonicParsing="false" onAction="#onSubmitHabits" styleClass="submit-button" text="Submit Today's Habits">
                  <font>
                     <Font name="System Bold" size="16.0" />
                  </font>
               </Button>
               
               <!-- Confirmation Feedback -->
               <Label fx:id="confirmationMessage" styleClass="confirmation-message" text="" visible="false">
                  <font>
                     <Font size="14.0" />
                  </font>
               </Label>
               
               <!-- XP Gain Display -->
               <Label fx:id="xpGainMessage" styleClass="xp-gain-message" text="" visible="false">
                  <font>
                     <Font name="System Bold" size="14.0" />
                  </font>
               </Label>
            </VBox>
         </VBox>
      </ScrollPane>
   </center>
   
   <!-- Bottom Navigation Bar -->
   <bottom>
      <HBox fx:id="bottomNavigationBar" alignment="CENTER" spacing="0.0" styleClass="bottom-navigation">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         
         <Button fx:id="petTabButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onPetTabClicked" styleClass="nav-button" text="Pet" HBox.hgrow="ALWAYS">
            <font>
               <Font size="14.0" />
            </font>
         </Button>
         
         <Button fx:id="habitsTabButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onHabitsTabClicked" styleClass="nav-button, nav-button-active" text="Habits" HBox.hgrow="ALWAYS">
            <font>
               <Font size="14.0" />
            </font>
         </Button>
         
         <Button fx:id="statsTabButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onStatsTabClicked" styleClass="nav-button" text="Stats" HBox.hgrow="ALWAYS">
            <font>
               <Font size="14.0" />
            </font>
         </Button>
         
         <Button fx:id="achievementsTabButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAchievementsTabClicked" styleClass="nav-button" text="Awards" HBox.hgrow="ALWAYS">
            <font>
               <Font size="14.0" />
            </font>
         </Button>
      </HBox>
   </bottom>
   
   <styleClass>
      <String fx:value="habit-input-view" />
   </styleClass>
</BorderPane>