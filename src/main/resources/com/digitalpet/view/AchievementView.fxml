<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane styleClass="achievement-view" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.digitalpet.view.AchievementViewController">
   <center>
      <VBox spacing="20.0" styleClass="main-content">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         
         <!-- Header Section -->
         <VBox spacing="10.0" styleClass="header-section">
            <Label styleClass="page-title" text="Achievements">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            
            <!-- Achievement Summary -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="achievement-summary">
               <Label fx:id="achievementCountLabel" styleClass="summary-text" text="0 / 15 Unlocked">
                  <font>
                     <Font size="16.0" />
                  </font>
               </Label>
               
               <ProgressBar fx:id="completionProgressBar" maxWidth="1.7976931348623157E308" prefWidth="150.0" progress="0.0" styleClass="completion-progress" HBox.hgrow="ALWAYS" />
               
               <Label fx:id="completionPercentageLabel" styleClass="summary-text" text="0%">
                  <font>
                     <Font size="16.0" />
                  </font>
               </Label>
            </HBox>
         </VBox>
         
         <!-- Category Filter Tabs -->
         <HBox spacing="5.0" styleClass="category-tabs">
            <Button fx:id="allCategoryButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAllCategoryClicked" styleClass="category-button, category-button-active" text="All" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            
            <Button fx:id="consistencyCategoryButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onConsistencyCategoryClicked" styleClass="category-button" text="🔥 Consistency" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            
            <Button fx:id="milestoneCategoryButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onMilestoneCategoryClicked" styleClass="category-button" text="🏆 Milestones" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            
            <Button fx:id="evolutionCategoryButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onEvolutionCategoryClicked" styleClass="category-button" text="⭐ Evolution" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
         </HBox>
         
         <!-- Achievement List Container -->
         <ScrollPane fx:id="achievementScrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="achievement-scroll" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
            <content>
               <VBox fx:id="achievementContainer" spacing="12.0" styleClass="achievement-container">
                  <padding>
                     <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
                  </padding>
                  
                  <!-- Achievement cards will be added programmatically -->
                  
               </VBox>
            </content>
         </ScrollPane>
         
         <!-- Celebration Overlay (initially hidden) -->
         <StackPane fx:id="celebrationOverlay" styleClass="celebration-overlay" visible="false">
            <VBox alignment="CENTER" spacing="20.0" styleClass="celebration-content">
               <Label fx:id="celebrationTitle" styleClass="celebration-title" text="🎉 Achievement Unlocked! 🎉">
                  <font>
                     <Font name="System Bold" size="20.0" />
                  </font>
               </Label>
               
               <Label fx:id="celebrationAchievementName" styleClass="celebration-achievement" text="Achievement Name">
                  <font>
                     <Font name="System Bold" size="18.0" />
                  </font>
               </Label>
               
               <Label fx:id="celebrationDescription" styleClass="celebration-description" text="Achievement description" textAlignment="CENTER" wrapText="true">
                  <font>
                     <Font size="14.0" />
                  </font>
               </Label>
               
               <Button fx:id="celebrationCloseButton" mnemonicParsing="false" onAction="#onCelebrationClose" styleClass="celebration-close-button" text="Continue">
                  <font>
                     <Font size="14.0" />
                  </font>
               </Button>
            </VBox>
         </StackPane>
      </VBox>
   </center>
   
   <!-- Bottom Navigation Bar -->
   <bottom>
      <HBox fx:id="bottomNavigationBar" alignment="CENTER" spacing="0.0" styleClass="bottom-navigation">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         
         <Button fx:id="petTabButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onPetTabClicked" styleClass="nav-button" text="Pet" HBox.hgrow="ALWAYS">
            <font>
               <Font size="14.0" />
            </font>
         </Button>
         
         <Button fx:id="habitsTabButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onHabitsTabClicked" styleClass="nav-button" text="Habits" HBox.hgrow="ALWAYS">
            <font>
               <Font size="14.0" />
            </font>
         </Button>
         
         <Button fx:id="statsTabButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onStatsTabClicked" styleClass="nav-button" text="Stats" HBox.hgrow="ALWAYS">
            <font>
               <Font size="14.0" />
            </font>
         </Button>
         
         <Button fx:id="achievementsTabButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAchievementsTabClicked" styleClass="nav-button, nav-button-active" text="Awards" HBox.hgrow="ALWAYS">
            <font>
               <Font size="14.0" />
            </font>
         </Button>
      </HBox>
   </bottom>
</BorderPane>